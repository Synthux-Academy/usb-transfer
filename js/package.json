    }
  },
  "files": ["index.js", "index.d.ts", "README.md", "LICENSE"],
  "sideEffects": false,
  "keywords": ["synthux", "synthuxacademy", "daisy", "web-serial", "web-midi", "usb"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Synthux-Academy/usb-transfer.git",
    "directory": "js"
  },
  "publishConfig": {
    "access": "public"
  }
}
